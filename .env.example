# ========== FRONTEND (Vite, lo usa tu web en Netlify) ==========

# Stripe (clave pública, esta es la que va en el frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_tu_clave_publica_o_placeholder

# URL de tu backend en la VPS (cuando lo tengamos listo)
VITE_API_URL=https://api.tudominio.com

# reCAPTCHA (site key pública de Google)
VITE_RECAPTCHA_SITE_KEY=tu_recaptcha_site_key_aqui

# Si algún día usas Supabase:
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_key_here


# ========== BACKEND (solo se usan en tu VPS / servidor) ==========

# Puerto donde escuchará tu backend
PORT=3000

# Stripe (clave secreta, SOLO backend, nunca frontend)
STRIPE_SECRET_KEY=sk_live_tu_clave_secreta_aqui

# reCAPTCHA secret (privada de Google)
RECAPTCHA_SECRET_KEY=tu_recaptcha_secret_key_aqui

# Configuración de correo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password
MAIL_TO=tu_correo@gmail.com
