# ========== FRONTEND (Vite, se usan en Netlify) ==========

# Stripe (clave pública, segura para frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_tu_clave_publica_o_placeholder

# URL de tu backend (el de tu VPS)
VITE_API_URL=https://api.tudominio.com

# reCAPTCHA (site key: la pública que te da Google)
VITE_RECAPTCHA_SITE_KEY=tu_recaptcha_site_key_aqui

# Si algún día usas Supabase:
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_key_here


# ========== BACKEND (solo en tu VPS, NO en Netlify) ==========

# Stripe (clave secreta, NUNCA en el frontend)
STRIPE_SECRET_KEY=sk_live_tu_clave_secreta

# reCAPTCHA secret (la privada de Google)
RECAPTCHA_SECRET_KEY=tu_recaptcha_secret_key_aqui

# Configuración correo (Gmail con contraseña de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password
MAIL_TO=tu_correo@gmail.com

# Puerto donde correrá el backend en tu VPS
PORT=3000
